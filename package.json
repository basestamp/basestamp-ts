{
  "name": "@basestamp/basestamp",
  "version": "0.2.0",
  "description": "TypeScript client library for Basestamp API with trustless Merkle proof verification",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint 'src/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "yarn build",
    "test:e2e": "BASESTAMP_E2E=1 jest src/__tests__/e2e.test.ts --verbose"
  },
  "keywords": [
    "basestamp",
    "timestamp",
    "merkle",
    "proof",
    "verification",
    "blockchain",
    "crypto"
  ],
  "author": "Patrick Shuff",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/basestamp/basestamp-ts.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "@types/node": "^20.6.3",
    "@types/node-fetch": "^2.6.4",
    "@typescript-eslint/eslint-plugin": "^6.7.2",
    "@typescript-eslint/parser": "^6.7.2",
    "eslint": "^8.49.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsup": "^7.2.0",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "node-fetch": "^2.7.0"
  },
  "module": "dist/index.mjs",
  "engines": {
    "node": ">=16"
  }
}
